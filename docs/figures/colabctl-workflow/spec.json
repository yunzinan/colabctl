    "title": "colabctl v0.2 full-stack architecture and end-to-end workflow",
    "system": {
      "name": "colabctl",
      "one_liner": "Multi-account Google Colab GPU launcher and local Web/Chromium dashboard with pre-warmed single-slot SSH multiplexing and an autonomous VM-side cost-guard watchdog"
    },
    "family": "systems",
    "kind": "architecture",
    "figure_kind": "request-path",
    "venue_style": "acm",
    "column": "double",
    "width_pt": 504,
    "max_height_pt": 216,
    "template": "host-device",
    "modifiers": [
      "multi-tier",
      "control-loop"
    ],
    "direction": "left-right",
