      "view": "structure",
      "order": 0
    },
    {
      "id": "mux-before",
      "label": "Without colabctl (Baseline)",
      "parent": "mux-compare",
      "axis": "alternatives",
      "differs": "Each client opens a separate SSH-over-WS slot; concurrent connections hit HTTP 429.",
      "verdict": "1/3 OK · HTTP 429 on concurrent use",
      "order": 0
    },
    {
      "id": "mux-after",
      "label": "With colabctl (ControlMaster Mux)",
      "parent": "mux-compare",
      "axis": "alternatives",
      "differs": "All clients share one pre-warmed ControlMaster Unix socket over a single WS slot.",
      "verdict": "All concurrent clients OK · 0 HTTP 429",
